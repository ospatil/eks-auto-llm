        <mxCell id="e-stream" value="stream weights" style="sketch=1;curveFitting=1;jiggle=2;strokeColor=#16a34a;strokeWidth=1;endArrow=open;endFill=0;fontSize=10;fontColor=#16a34a;labelBackgroundColor=#d5e8d4;" edge="1" source="s3" target="pod" parent="1">
          <mxGeometry relative="1" as="geometry" />
