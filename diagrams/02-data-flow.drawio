        <mxCell id="leg2" value="■ blue = one-time staging (your laptop)   ■ green = runtime, in-AWS only (no cluster egress)" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#16a34a;fontStyle=2;" vertex="1" parent="1">
