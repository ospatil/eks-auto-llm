<mxfile host="app.diagrams.net" agent="Claude" version="24.0.0">
  <diagram name="Data Flow" id="data-flow">
    <mxGraphModel dx="1100" dy="700" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="900" pageHeight="500" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="Model Weights &amp; Image - Out-of-Band Staging, In-AWS Runtime" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;fontColor=#4f46e5;strokeColor=none;fillColor=none;" vertex="1" parent="1">
          <mxGeometry x="170" y="8" width="560" height="30" as="geometry" />
        </mxCell>

        <!-- Internet sources -->
        <mxCell id="hf" value="HuggingFace Hub" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fillColor=#fee2e2;strokeColor=#dc2626;fontColor=#7f1d1d;arcSize=15;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="90" width="150" height="50" as="geometry" />
        </mxCell>
        <mxCell id="ecrpub" value="ECR Public&#xa;(vLLM DLC, no auth)" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fillColor=#fee2e2;strokeColor=#dc2626;fontColor=#7f1d1d;arcSize=15;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="330" width="150" height="50" as="geometry" />
        </mxCell>

        <!-- Laptop (out of band actor) -->
        <mxCell id="laptop" value="Your laptop&#xa;(has internet + admin creds)" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fillColor=#eef2ff;strokeColor=#4f46e5;fontColor=#1e1b4b;fontStyle=1;arcSize=15;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="310" y="200" width="170" height="60" as="geometry" />
        </mxCell>

        <!-- AWS account boundary -->
        <mxCell id="aws" value="" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fillColor=#f8fafc;strokeColor=#4f46e5;strokeWidth=1;arcSize=4;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="60" width="310" height="400" as="geometry" />
        </mxCell>
        <mxCell id="aws-label" value="AWS account (your region)" style="text;html=1;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;fontColor=#4f46e5;" vertex="1" parent="1">
          <mxGeometry x="578" y="68" width="260" height="20" as="geometry" />
        </mxCell>

        <!-- S3 -->
        <mxCell id="s3" value="S3 bucket&#xa;model weights (safetensors)" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fillColor=#eef2ff;strokeColor=#4f46e5;fontColor=#1e1b4b;arcSize=15;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="600" y="110" width="230" height="55" as="geometry" />
        </mxCell>
        <!-- ECR cache -->
        <mxCell id="ecr" value="ECR pull-through cache&#xa;(backing repo auto-created)" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fillColor=#eef2ff;strokeColor=#4f46e5;fontColor=#1e1b4b;arcSize=15;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="600" y="330" width="230" height="55" as="geometry" />
        </mxCell>

        <!-- Cluster -->
        <mxCell id="pod" value="vLLM pod (GPU)" style="rounded=1;whiteSpace=wrap;html=1;sketch=1;curveFitting=1;jiggle=2;fillColor=#d5e8d4;strokeColor=#16a34a;fontColor=#1e1b4b;arcSize=15;fontSize=11;fontStyle=1;" vertex="1" parent="1">
          <mxGeometry x="630" y="225" width="170" height="55" as="geometry" />
        </mxCell>

        <!-- Edges: staging -->
        <mxCell id="e-hf" value="1 · huggingface-cli download" style="sketch=1;curveFitting=1;jiggle=2;strokeColor=#4f46e5;strokeWidth=1;endArrow=open;endFill=0;fontSize=10;fontColor=#4f46e5;labelBackgroundColor=#f8fafc;" edge="1" source="hf" target="laptop" parent="1">
          <mxGeometry relative="1" as="geometry" />
