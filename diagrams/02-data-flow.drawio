        <mxCell id="e-s3up" value="2 · aws s3 sync (make stage)" style="sketch=1;curveFitting=1;jiggle=2;strokeColor=#4f46e5;strokeWidth=1;endArrow=open;endFill=0;fontSize=10;fontColor=#4f46e5;labelBackgroundColor=#f8fafc;" edge="1" source="laptop" target="s3" parent="1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-prewarm" value="3 · docker pull via cache (make prewarm)" style="sketch=1;curveFitting=1;jiggle=2;strokeColor=#4f46e5;strokeWidth=1;endArrow=open;endFill=0;fontSize=10;fontColor=#4f46e5;labelBackgroundColor=#f8fafc;" edge="1" source="laptop" target="ecr" parent="1">
