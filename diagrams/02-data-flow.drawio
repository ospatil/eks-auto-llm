        <mxCell id="e-stream" value="stream weights" style="sketch=1;curveFitting=1;jiggle=2;strokeColor=#16a34a;strokeWidth=1;endArrow=open;endFill=0;fontSize=10;fontColor=#16a34a;labelBackgroundColor=#f8fafc;exitX=0.5;exitY=1;entryX=0.5;entryY=0;" edge="1" source="s3" target="pod" parent="1">
