        <!-- ECR fetches upstream server-side -->
        <mxCell id="e-upstream" value="ECR fetches server-side (AWS IPs)" style="sketch=1;curveFitting=1;jiggle=2;strokeColor=#dc2626;strokeWidth=1;endArrow=open;endFill=0;dashed=1;fontSize=10;fontColor=#dc2626;labelBackgroundColor=#ffffff;" edge="1" source="ecrpub" target="ecr" parent="1">
          <mxGeometry relative="1" as="geometry" />
