        </mxCell>
        <mxCell id="e-s3up" value="2 · aws s3 sync&#xa;(make stage)" style="sketch=1;curveFitting=1;jiggle=2;strokeColor=#4f46e5;strokeWidth=1;endArrow=open;endFill=0;fontSize=10;fontColor=#4f46e5;labelBackgroundColor=none;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="laptop" target="s3" parent="1">
