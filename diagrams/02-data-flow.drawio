        <!-- Legend -->
        <mxCell id="leg1" value="■ red = public internet (touched ONLY out-of-band or by ECR server-side)" style="text;html=1;align=left;verticalAlign=middle;fontSize=10;fontColor=#dc2626;fontStyle=2;" vertex="1" parent="1">
