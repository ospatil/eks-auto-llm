        <!-- Staging (blue) -->
        <mxCell id="e-hf" value="1 · hf download" style="sketch=1;curveFitting=1;jiggle=2;strokeColor=#4f46e5;strokeWidth=1;endArrow=open;endFill=0;fontSize=10;fontColor=#4f46e5;labelBackgroundColor=none;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" edge="1" source="hf" target="laptop" parent="1">
