        <!-- Legend -->
        <mxCell id="leg" value="Red = public internet, touched only from your laptop or by ECR itself · blue = one-time staging from your laptop · green = runtime, inside AWS (no cluster egress)" style="text;html=1;align=center;verticalAlign=middle;fontSize=9;fontColor=#64748b;fontStyle=2;" vertex="1" parent="1">
